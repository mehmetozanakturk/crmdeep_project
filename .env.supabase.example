# Supabase Configuration
# Copy this file to .env.local and fill in your Supabase project credentials

# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/Public Key (safe to use in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (NEVER expose to browser - use in API routes only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database URL (for migrations and direct access)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Optional: Supabase JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here
